{
  "name": "next-wms",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "build": "turbo build",
    "build:web": "turbo -F web build",
    "check": "biome check --write .",
    "check-types": "turbo check-types",
    "dev": "turbo -F web dev -F @wms/backend db:dev",
    "dev:web": "turbo -F web dev",
    "dev:backend": "turbo -F @wms/backend db:app:dev",
    "deploy:vercel": "turbo -F @wms/backend deploy:vercel",
    "seed:auth": "turbo -F @wms/backend db:auth:seed-demo",
    "seed:demo": "turbo -F @wms/backend seed:demo",
    "reset:demo": "turbo -F @wms/backend reset:demo"
  },
  "dependencies": {
    "dotenv": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4",
    "@types/node": "catalog:",
    "tsdown": "^0.22.9",
    "turbo": "^2.10.5"
  },
  "packageManager": "pnpm@11.10.0"
}
