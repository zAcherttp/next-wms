{
  "name": "@wms/backend",
  "version": "1.0.0",
  "type": "module",
  "private": true,
  "exports": {
    "./auth": {
      "types": "./auth/index.ts",
      "default": "./auth/index.ts"
    },
    "./auth/handler": {
      "types": "./auth/handler.ts",
      "default": "./auth/handler.ts"
    },
    "./auth/schema": {
      "types": "./auth/schema.ts",
      "default": "./auth/schema.ts"
    },
    "./auth/db": {
      "types": "./auth/db.ts",
      "default": "./auth/db.ts"
    },
    "./lib/permissions": {
      "types": "./lib/permissions.ts",
      "default": "./lib/permissions.ts"
    },
    "./convex/_generated/api": {
      "types": "./convex/_generated/api.d.ts",
      "default": "./convex/_generated/api.js"
    },
    "./convex/_generated/dataModel": {
      "types": "./convex/_generated/dataModel.d.ts",
      "default": "./convex/_generated/dataModel.js"
    }
  },
  "scripts": {
    "check-types": "tsc --noEmit",
    "db:app:dev": "convex dev",
    "db:app:setup": "convex dev --configure --until-success && convex dashboard",
    "db:auth:generate": "drizzle-kit generate",
    "db:auth:migrate": "drizzle-kit migrate",
    "db:auth:push": "drizzle-kit push",
    "db:auth:seed-demo": "tsx auth/seed-demo.ts",
    "db:auth:studio": "drizzle-kit studio",
    "deploy:vercel": "convex deploy --cmd-url-env-var-name NEXT_PUBLIC_CONVEX_URL --cmd \"corepack pnpm --dir ../.. build:web\" --preview-run seedMockData:seedAllTestData",
    "dev:email": "email dev -p 3001",
    "reset:demo": "convex run myFunctions:resetDemoData",
    "seed:demo": "convex run seedMockData:seedAllTestData"
  },
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "@react-email/ui": "6.9.0",
    "@types/node": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "drizzle-kit": "^0.31.10",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-email": "6.9.0",
    "tsx": "^4.23.1",
    "typescript": "catalog:"
  },
  "dependencies": {
    "@neondatabase/serverless": "^1.1.0",
    "better-auth": "catalog:",
    "convex": "catalog:",
    "dotenv": "catalog:",
    "drizzle-orm": "^0.45.2",
    "resend": "^6.17.2",
    "zod": "catalog:"
  }
}
